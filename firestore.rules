rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public study guides.
    // Readable by anyone (public study-guide pages + SSR REST fetch are unauthenticated).
    // Writable only via the Admin SDK (scripts/seed-study-guides.ts) — rules never apply to it.
    match /notes/{noteId} {
      allow read: if true;
      allow write: if false;
    }

    // User account docs, keyed by email-derived ID (matches the iOS app's client-side schema).
    // Signed-in clients (web + iOS) read and write their subscription/profile data here.
    match /users/{userId} {
      allow read, write: if request.auth != null;

      // Per-user profiles
      match /profiles/{profileId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
