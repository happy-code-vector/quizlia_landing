rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Server-anchored local date (YYYY-MM-DD) — quota docs must always
    // carry exactly this, so clients can't jump the date forward.
    function quizliaToday() {
      let m = request.time.month();
      let d = request.time.day();
      return string(request.time.year()) + "-"
        + (m < 10 ? "0" + string(m) : string(m)) + "-"
        + (d < 10 ? "0" + string(d) : string(d));
    }


    // Super admins: users/{uid}.admin == true, set directly in the
    // Firebase console (Admin SDK bypasses rules). A get() on a missing
    // doc fails closed — the write is denied.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }


    // Public study guides.
    // Readable by anyone (public study-guide pages + SSR REST fetch are
    // unauthenticated). Only super admins (users/{uid}.admin) publish;
    // their guides are listed library content. Owners keep unpublish
    // (delete) on docs they created under the old model.
    match /notes/{noteId} {
      allow read: if true;
      // Publishing is super-admin-only now; admin publishes go straight
      // into the public library (listed). Legacy owners keep unpublish.
      allow create: if isAdmin()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Device-keyed server state for signed-out iOS callers (spec §7).
    // Written/read only by the Admin SDK (Netlify); clients never touch it.
    match /devices/{deviceId} {
      allow read, write: if false;
    }

    // Stripe subscription → uid mapping used by the webhook (Task 8).
    match /stripeSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    // User data is UID-keyed and readable/writable only by its owner
    // (web + iOS share this schema). The migration script (Admin SDK)
    // moves the old email-keyed docs into these paths.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Owner-writable EXCEPT the admin flag. On update, the post-write
      // value of `admin` (absent = keeps the current value via merge) must
      // equal the pre-write value; a full replace that drops it is DENIED
      // (no silent de-admining). On create there is no pre-state, so the
      // requirement is simply that `admin` is absent/false — nobody signs
      // themselves up as admin. (Split create/update: reading
      // resource.data on a not-yet-existing doc errors in the engine and
      // denied every first-time user-doc create — seen live 2026-10-20.)
      // The console / Admin SDK bypass rules to set it.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.get('admin', false) == false;
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.get('admin', false)
                       == resource.data.get('admin', false);

      allow delete: if request.auth != null && request.auth.uid == userId;

      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /notes/{noteId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Folder definitions (web organization; the app carries folderName
        // inside its synced note docs).
        match /folders/{folderId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Generation quota — tamper-proof by rules, no service account:
    // counters may only rise by at most 1 per write (or restart on a true
    // rollover, anchored to SERVER time so nobody can jump the date),
    // chatUsed likewise, freeUsed may only flip on, deletes never.
    match /generationQuota/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.date == quizliaToday()
                    && request.resource.data.used is int
                    && request.resource.data.used >= 0
                    && request.resource.data.used <= 1;

      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.date == quizliaToday()
                    && (
                      // Same day: at most +1 on each counter, never a reset.
                      (
                        resource.data.get('date', '') == quizliaToday()
                        && request.resource.data.used >= resource.data.get('used', 0)
                        && request.resource.data.used <= resource.data.get('used', 0) + 1
                        && request.resource.data.get('chatUsed', 0) >= resource.data.get('chatUsed', 0)
                        && request.resource.data.get('chatUsed', 0) <= resource.data.get('chatUsed', 0) + 1
                        && (!resource.data.get('freeUsed', false)
                            || request.resource.data.get('freeUsed', false) == true)
                      )
                      // Genuine rollover: doc is from an earlier day.
                      || (
                        resource.data.get('date', '') < quizliaToday()
                        && request.resource.data.used is int
                        && request.resource.data.used >= 0
                        && request.resource.data.used <= 1
                      )
                    );

      allow delete: if false;
    }

    // Promo codes: readable by signed-in clients (redemption checks),
    // written only via the Admin SDK (generation + import).
    match /promoCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
