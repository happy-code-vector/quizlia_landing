rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public study guides.
    // Readable by anyone (public study-guide pages + SSR REST fetch are unauthenticated).
    // Writable only via the Admin SDK (scripts/seed-study-guides.ts) — rules never apply to it.
    match /notes/{noteId} {
      allow read: if true;
      allow write: if false;
    }

    // User data is UID-keyed and readable/writable only by its owner
    // (web + iOS share this schema). The migration script (Admin SDK)
    // moves the old email-keyed docs into these paths.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /notes/{noteId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Promo codes: readable by signed-in clients (redemption checks),
    // written only via the Admin SDK (generation + import).
    match /promoCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
