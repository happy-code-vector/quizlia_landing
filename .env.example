# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Gemini key used by /api/generate and /api/chat
# (set in Netlify → Site settings → Environment variables)
GEMINI_API_KEY=

# /api/ios/study-from-video (PRD F2): captions + generation
# (set in Netlify → Site settings → Environment variables)
ANTHROPIC_API_KEY=
SUPADATA_API_KEY=
TRANSCRIPTAPI_KEY=

# Stripe (server-side; checkout runs in demo mode when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs for the plans that mirror the iOS app lineup
# (create recurring prices: $7.00/week, $59.99/year individual, $79.99/year family)
NEXT_PUBLIC_STRIPE_PRICE_WEEKLY=
NEXT_PUBLIC_STRIPE_PRICE_INDIVIDUAL_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_FAMILY_YEARLY=

# Firebase Admin (server-only; used by /api/ios/* device path, entitlements,
# Stripe webhook, scripts). Base64 keeps it single-line for Netlify:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("firebase-service-account.json"))
FIREBASE_SERVICE_ACCOUNT_B64=

# App Check enforcement flip (log-only until the acquirer signs off; leave unset)
APP_CHECK_ENFORCE=

# Web App Check provider site key — reCAPTCHA ENTERPRISE ("Fraud Defense";
# classic reCAPTCHA v3 keys are deprecated by Google).
# Create it in Google Cloud console → Security → reCAPTCHA (Fraud Defense),
# in the cloud project behind the Firebase project, as a Web-type score-based
# key with domain quizliai.com. NEVER add localhost to this key — local dev
# uses the App Check debug token instead (see lib/firebase.ts).
# Then register the web app with it: Firebase console → App Check → Apps.
NEXT_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=
